# =============================================================
# 环境变量清单（复制为 .env.local 后填入真实值；.env*.local 不入库）
# =============================================================

# Supabase 项目地址（可暴露到浏览器）
NEXT_PUBLIC_SUPABASE_URL=

# anon key：仅具备 RLS 允许的只读能力，用于服务端只读查询
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 🔴 service_role key：绕过 RLS 的高权限凭据
# 仅供服务端 lib/supabase/admin.ts 使用，严禁加 NEXT_PUBLIC_ 前缀，严禁进入浏览器 bundle
SUPABASE_SERVICE_ROLE_KEY=
